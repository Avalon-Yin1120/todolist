/.gradle/
/build/
/app/build/
/local.properties
/.idea/
*.iml
.DS_Store
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.jks
*.keystore

# release 签名材料：keystore 与口令绝不进版本库（丢了就无法再给同一个应用发包）
/release/

# Kotlin 编译器的会话目录（增量编译缓存），每次构建都可能出现，不该进版本库
/.kotlin/

# 构建/测试日志与临时产物（含「生成物」目录，开源时一律不入库）
*.log
/build-test.log
/app/release/

# 本地评估工具（许可证扫描之类）装在 build/ 下，一并忽略
/build/venv-scancode/
/build/pylibs*/

# 本地出包产物（Release 附件从仓库外上传，不入库）
/dist/
