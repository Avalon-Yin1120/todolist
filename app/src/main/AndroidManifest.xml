<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 发送提醒通知（Android 13+ 需要运行时授予） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 精确闹钟（Android 12+ 为特殊权限，需用户在系统设置中允许） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 开机后重新排定未完成的提醒 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 闹钟式提醒：全屏 Intent 在锁屏上直接弹出提醒页 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 提醒时点亮屏幕并保持常亮 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 提醒时振动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 闹钟式提醒的前台服务：保证到点响铃、亮屏并弹出提醒页 -->
    <!-- 请求加入电池优化白名单：否则厂商省电策略会让到点提醒不响或晚很久 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".TodoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Todolist">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Todolist">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 闹钟式提醒页：由通知的全屏 Intent 拉起，需能在锁屏上显示并点亮屏幕 -->
        <activity
            android:name=".ui.alarm.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Todolist" />

        <!-- 精确闹钟到点回调 -->
        <receiver
            android:name=".reminder.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- 提醒通知上的「完成」「10 分钟后再提醒」操作 -->
        <receiver
            android:name=".notify.ReminderActionReceiver"
            android:exported="false" />

        <!-- 开机 / 系统时间变化后重排 -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- 闹钟式提醒的前台服务：只靠通知的全屏 Intent 在屏幕亮着时不会拉起界面，
             这里主动播放闹钟铃声并直接打开闹钟页 -->
        <service
            android:name=".notify.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm_ringing" />
        </service>
    </application>

</manifest>
