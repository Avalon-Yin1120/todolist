<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 发送提醒通知（Android 13+ 需要运行时授予） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      精确闹钟，两个权限分别服务于不同的 Android 版本：
      * SCHEDULE_EXACT_ALARM（Android 12）：需要用户在系统设置里手动允许，可能被拒；
      * USE_EXACT_ALARM（Android 13+）：**安装即授予、用户关不掉**，代价是 Google Play
        只允许「闹钟 / 日历」类应用声明它，上架时要在后台说明用途（本应用属提醒类，符合）。

      为什么两个都要：只留 SCHEDULE_EXACT_ALARM 时，用户一关（部分 ROM 默认就是关的）
      提醒就从「精确到分钟」退化成「大约那个点」，而且那个开关页还不一定找得到；
      只留 USE_EXACT_ALARM 时 Android 12 上根本没有这个权限可声明。
      调度器仍保留「两个都没有就退化为非精确」的兜底，所以不会因此崩。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 开机后重新排定未完成的提醒 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 闹钟式提醒：全屏 Intent 在锁屏上直接弹出提醒页 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 提醒时点亮屏幕并保持常亮 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 提醒时振动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 闹钟式提醒的前台服务：保证到点响铃、亮屏并弹出提醒页 -->
    <!--
      刻意不声明 REQUEST_IGNORE_BATTERY_OPTIMIZATIONS：
      它能让应用直接弹出「是否允许后台运行」的系统确认框，但 Google Play 的内容政策
      不允许普通应用申请它（Android 自带的 lint 有专门一条 BatteryLife 检查会因此报
      「violates the Play Store Content Policy」）。改为打开系统的电池优化列表页，
      由用户把本应用设为「不优化」，功能一样、上架无风险；
      读取「是否已豁免」本来就不需要权限，所以界面上的状态判断照旧准确。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".TodoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Todolist">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Todolist">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 闹钟式提醒页：由通知的全屏 Intent 拉起，需能在锁屏上显示并点亮屏幕 -->
        <activity
            android:name=".ui.alarm.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Todolist" />

        <!-- 精确闹钟到点回调 -->
        <receiver
            android:name=".reminder.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- 提醒通知上的「完成」「10 分钟后再提醒」操作 -->
        <receiver
            android:name=".notify.ReminderActionReceiver"
            android:exported="false" />

        <!-- 开机 / 系统时间变化后重排 -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- 闹钟式提醒的前台服务：只靠通知的全屏 Intent 在屏幕亮着时不会拉起界面，
             这里主动播放闹钟铃声并直接打开闹钟页 -->
        <service
            android:name=".notify.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm_ringing" />
        </service>

        <!--
          WorkManager 的「按需初始化」：本应用实现了 Configuration.Provider
          （见 TodoApp.workManagerConfiguration），但 WorkManager 库自带的
          androidx.startup 初始化器仍会在进程启动时用**默认配置**抢先初始化一次，
          我们那份配置就被静默忽略——lint 为此直接报错
          （RemoveWorkManagerInitializer）。把这条 meta-data 移除后，
          WorkManager 会在第一次 getInstance(context) 时才按我们的配置初始化，
          顺带也让冷启动少一次初始化。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
